# Local development only: copy to .dev.vars (ignored by git).
# Test mode simulates the identity with the X-Ppu-Test-User header,
# using the fake users of the demo data. Rejected outside local and preview.
DOMAIN=example.org
GROUP_NAME=Gruppo Demo
TEST_MODE=on
# Optional: Google login for the MCP (a test OAuth client, never the production one).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
