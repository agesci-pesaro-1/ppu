// Configurazione del Worker PPU.
//
// Nessun valore specifico del gruppo qui. Negli ambienti pubblicati la pipeline
// genera wrangler.generato.json con scripts/configura-wrangler.ts, inserendo
// dominio, Access, database e rotte dalle variabili di GitHub
// (docs/installazione/pipeline.md). Il generatore rifiuta MODALITA_TEST fuori
// da locale e preview.
//
// Commenti solo su righe intere: il generatore li toglie riga per riga.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ppu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // In locale la modalità di test si attiva da .dev.vars (vedi .dev.vars.example),
  // mai qui: questa sezione è la base anche degli ambienti pubblicati.
  "vars": {
    "AMBIENTE": "locale"
  },
  // PWA (packages/pwa) servita come asset statici dallo stesso Worker (ADR 0014):
  // stessa origine dell'API. I percorsi di API, MCP e OAuth vanno sempre al Worker;
  // gli altri sono file della PWA, con fallback su index.html.
  "assets": {
    "directory": "../pwa/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/authorize",
      "/.well-known/*",
      "/salute"
    ]
  },
  // KV del provider OAuth dell'MCP (token e client cifrati o sotto hash).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppu-locale",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "env": {
    // Una per pull request: D1 separato con seed demo, identità simulata.
    "preview": {
      "name": "ppu-preview",
      "assets": {
        "directory": "../pwa/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/mcp",
          "/mcp/*",
          "/oauth/*",
          "/authorize",
          "/.well-known/*",
          "/salute"
        ]
      },
      "workers_dev": true,
      "vars": {
        "AMBIENTE": "preview",
        "DOMINIO": "example.org",
        "NOME_GRUPPO": "Anteprima PPU",
        "MODALITA_TEST": "attiva"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ppu-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../migrations"
        }
      ]
    },
    // Al merge su main. Usa il D1 di produzione (ADR 0008).
    "beta": {
      "name": "ppu-beta",
      "assets": {
        "directory": "../pwa/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/mcp",
          "/mcp/*",
          "/oauth/*",
          "/authorize",
          "/.well-known/*",
          "/salute"
        ]
      },
      "workers_dev": false,
      "vars": {
        "AMBIENTE": "beta"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ppu",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../migrations"
        }
      ]
    },
    // Promozione manuale da GitHub.
    "produzione": {
      "name": "ppu-produzione",
      "assets": {
        "directory": "../pwa/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/mcp",
          "/mcp/*",
          "/oauth/*",
          "/authorize",
          "/.well-known/*",
          "/salute"
        ]
      },
      "workers_dev": false,
      "vars": {
        "AMBIENTE": "produzione"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ppu",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
